rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDailyRecord(data) {
      return data.keys().hasAll(['date', 'day', 'month', 'year', 'employees'])
        && data.date is string && data.date.size() <= 20
        && data.day is number && data.day >= 1 && data.day <= 31
        && data.month is number && data.month >= 1 && data.month <= 12
        && data.year is number && data.year >= 2000 && data.year <= 2100
        && data.employees is list
        && data.employees.size() <= 1000;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Daily attendance records
    match /daily_records/{dateId} {
      allow get, list: if true;
      allow create, update: if isValidId(dateId) && isValidDailyRecord(request.resource.data);
      allow delete: if isValidId(dateId);
    }
  }
}
